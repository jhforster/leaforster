---
import { site } from '~/content/site';

const icons: Record<string, string> = {
  Anxiety:
    '<path d="M3 12h3l2-7 4 14 2-7h7"/>',
  Depression:
    '<path d="M17 19a4 4 0 0 0 0-8 6 6 0 0 0-11.61-2A4 4 0 0 0 6 19h11Z"/>',
  'Substance use':
    '<path d="M7 3h10l-1 5a4 4 0 0 1-8 0L7 3Z"/><path d="M9 21h6"/><path d="M12 13v8"/>',
};
const defaultIcon = '<circle cx="12" cy="12" r="8"/>';
---

<section id="services" aria-labelledby="services-heading" class="py-20 md:py-28">
  <div class="container-prose">
    <p class="eyebrow mb-4">Services</p>
    <h2 id="services-heading" class="mb-3 max-w-prose">Therapy for adolescents and adults in {site.location.city}, {site.location.region}.</h2>
    <p class="text-ink/70 text-lg max-w-prose mb-12">
      In-person at my Beverly office and virtual sessions for clients across Massachusetts — including {site.areasServed.slice(0, 5).map((a) => a.replace(/, MA$/, '')).join(', ')}, and the broader North Shore and Greater Boston area.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {site.specialties.map((s) => (
        <article class="flex flex-col rounded-soft bg-white border border-lavender-100 shadow-card p-8 hover:border-lavender-300 transition-colors">
          <div class="w-12 h-12 rounded-full bg-lavender-100 text-lavender-700 flex items-center justify-center mb-6 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.title] ?? defaultIcon} />
          </div>
          <h3 class="!text-xl mb-3 leading-snug">{s.title}</h3>
          <p class="text-ink/75 leading-relaxed">{s.blurb}</p>
        </article>
      ))}
    </div>

    <div class="mt-14 pt-12 border-t border-lavender-100 grid lg:grid-cols-2 gap-10 lg:gap-16">
      <div>
        <p class="eyebrow mb-3">My approach</p>
        <h3 class="!text-2xl mb-4">Evidence-based methods, tailored to you.</h3>
        <p class="text-ink/70 mb-7 leading-relaxed">
          I draw from a few core therapeutic approaches and blend them to fit what each session actually calls for — collaborative, practical, and grounded.
        </p>
        <ul class="flex flex-wrap gap-3">
          {site.methods.map((m) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-white border border-lavender-200 px-4 py-2 text-sm font-medium text-ink">
              <span class="w-1.5 h-1.5 rounded-full bg-lavender-500" aria-hidden="true"></span>
              {m.title}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-3">Insurance accepted</p>
        <h3 class="!text-2xl mb-4">In-network with most major plans.</h3>
        <p class="text-ink/70 mb-7 leading-relaxed">
          I work with the following insurance plans through Headway, which verifies your benefits and handles billing — most clients pay only a copay.
        </p>
        <ul class="flex flex-wrap gap-2">
          {site.insurances.map((ins) => (
            <li class="inline-flex items-center rounded-full bg-lavender-50 border border-lavender-200/70 px-3.5 py-1.5 text-sm text-ink/85">
              {ins}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 relative overflow-hidden rounded-soft bg-gradient-to-br from-lavender-100 via-blush-200/50 to-sand/70 border border-lavender-200/70 shadow-card p-8 md:p-10">
      <div aria-hidden="true" class="absolute -top-16 -right-12 w-56 h-56 rounded-full bg-white/30 blur-2xl pointer-events-none"></div>
      <div aria-hidden="true" class="absolute -bottom-20 -left-16 w-64 h-64 rounded-full bg-lavender-200/25 blur-2xl pointer-events-none"></div>

      <div class="relative flex flex-col md:flex-row md:items-center gap-6 md:gap-10 justify-between">
        <div class="max-w-xl">
          <h3 class="!text-xl md:!text-2xl mb-3 leading-tight">Curious if we’d be a good fit?</h3>
          <p class="text-ink/80 text-lg leading-relaxed">
            Book a first session and we’ll figure that out together — no pressure to keep coming back if it isn’t the right match.
          </p>
        </div>
        <a href={site.headwayUrl} target="_blank" rel="noopener" class="btn-primary shrink-0 text-base px-7 py-3.5">
          Book on Headway
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
