---
import { site } from '~/content/site';
const nav = [
  { label: 'About', href: '#about' },
  { label: 'Services', href: '#services' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-40 backdrop-blur bg-cream/80 border-b border-lavender-100">
  <div class="container-prose flex items-center justify-between py-4">
    <a href="#top" class="no-underline group">
      <span class="font-serif text-xl font-medium text-ink">{site.name}</span>
      <span class="hidden sm:inline text-ink/60 font-sans text-sm ml-2">{site.title}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-7">
      {nav.map(({ label, href }) => (
        <a href={href} class="no-underline text-ink/80 hover:text-lavender-700 text-sm font-medium">{label}</a>
      ))}
      <a href={site.headwayUrl} target="_blank" rel="noopener" class="btn-primary text-sm py-2 px-4">Book a session</a>
    </nav>

    <a href={site.headwayUrl} target="_blank" rel="noopener" class="md:hidden btn-primary text-sm py-2 px-4">Book</a>
  </div>
</header>
